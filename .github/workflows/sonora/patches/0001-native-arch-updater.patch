+    /// Uses the same package updater as `sonora -U`, outside the UI thread.
+    fn install_arch(&mut self, helper: &'static str, cx: &mut Context<Self>) {
+        if self.offered().is_none() {
+            return;
+        }
+        self.state = UpdateState::Fetching;
+        cx.notify();
+        let io = self.io.clone();
+        self.task = Some(cx.spawn(async move |this, cx| {
+            let installed = join(io.spawn(async move {
+                tokio::task::spawn_blocking(move || {
+                    let result = Command::new(helper)
+                        .args([
+                            "install",
+                            "--gui",
+                            "--parent-pid",
+                            &std::process::id().to_string(),
+                        ])
+                        .output()
+                        .context("cannot start the native arch updater")?;
+                    if !result.status.success() {
+                        anyhow::bail!(
+                            "native arch updater failed: {}",
+                            String::from_utf8_lossy(&result.stderr)
+                        );
+                    }
+                    Ok(())
+                })
+                .await
+                .context("the native arch updater worker failed")?
+            }))
+            .await;
+            match installed {
+                Ok(()) => {
+                    cx.update(|cx| cx.quit());
+                }
+                Err(error) => {
+                    log::warn!("updates: cannot install the native arch package: {error:#}");
+                    this.update(cx, |this, cx| {
+                        this.task = None;
+                        this.state = UpdateState::Failed;
+                        cx.notify();
+                    })
+                    .ok();
+                }
+            }
+        }));
+    }

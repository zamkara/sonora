+/// Compile-time opt-in; ordinary upstream builds retain their own updater behavior.
+const fn arch_helper() -> Option<&'static str> {
+    if cfg!(target_os = "linux") {
+        option_env!("SONORA_ARCH_UPDATE_HELPER")
+    } else {
+        None
+    }
+}
